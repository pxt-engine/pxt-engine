#version 460

layout(push_constant) uniform CompositionPushConstants {
    vec4 selectedObjectColor;  // The object to highlight
    vec4 outlineColor;         // RGBA highlight color
    uint outlineThickness;     // Thickness of the outline in pixels
    
} push;

// input images
layout(set = 0, binding = 0) uniform sampler2D sceneColor;     // Scene color buffer
layout(set = 0, binding = 1) uniform sampler2D objectIdColor;  // Object ID buffer

// output image
layout(set = 0, binding = 2) uniform writeonly image2D outputImage;

// workgroup size
layout(local_size_x = 8, local_size_y = 8) in;

vec3 fetchIdColor(ivec2 coord, ivec2 imageExtent) {
    // clamp to image boundaries
    ivec2 clamped = clamp(coord, ivec2(0), imageExtent - 1);
    return texelFetch(objectIdColor, clamped, 0).rgb;
}

vec4 fetchSceneColor(ivec2 coord, ivec2 imageExtent) {
    ivec2 clamped = clamp(coord, ivec2(0), imageExtent - 1);
    return texelFetch(sceneColor, clamped, 0);
}

void main() {
    ivec2 imageExtent = imageSize(outputImage);
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec3 invalidColorId = vec3(0.0, 0.0, 0.0);

    if (pixelCoord.x >= imageExtent.x || pixelCoord.y >= imageExtent.y) {
        return; // outside bounds
    }

    // Example placeholder
    vec4 sceneColor = fetchSceneColor(pixelCoord, imageExtent);

    // Determine if the current pixel belongs to the selected object
    vec3 currentIdColor = fetchIdColor(pixelCoord, imageExtent);

    // if we are inside the selected object, we return its scene color
    if (push.selectedObjectColor.rgb == invalidColorId ||
        currentIdColor == push.selectedObjectColor.rgb) {

        imageStore(outputImage, pixelCoord, sceneColor);
        return;
    }

    int thickness = int(push.outlineThickness);

    // when outside the object, check neighboring pixels within the outline thickness 
    for (int y = -thickness; y <= thickness; y++) {
        for (int x = -thickness; x <= thickness; x++) {

            ivec2 neighborCoord = pixelCoord + ivec2(x, y);
            vec3 neighborIdColor = fetchIdColor(neighborCoord, imageExtent);

            if (neighborIdColor == push.selectedObjectColor.rgb) {
                // We found a neighboring pixel that belongs to the selected object
                // so we draw the outline color here
                imageStore(outputImage, pixelCoord, push.outlineColor);
                return;
            }
        }
    }

    // otherwise, keep the original scene color
    imageStore(outputImage, pixelCoord, sceneColor);
}
